// Cấu hình Cloudflare Worker "lichdica".
// Tên + ngày tương thích lấy đúng theo bản bot Cloudflare tự đề xuất
// (nhánh cloudflare/workers-autoconfig) để vẫn là worker đang chạy web.
// Thêm "main" để có chỗ nhận webhook Zalo; file tĩnh vẫn phục vụ như cũ.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lichdica",
  "main": "worker/index.js",
  "compatibility_date": "2026-04-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Key Claude đang mua qua bên thứ 3 (vilao.ai) nên gọi qua máy chủ của họ,
  // và bên đó đặt tên model là claude-haiku-4.5 (dấu chấm). Hai thông tin này
  // không bí mật; key thật vẫn để ở secret ANTHROPIC_API_KEY.
  // Đổi sang key chính chủ Anthropic: xoá cả khối "vars" này đi.
  "vars": {
    "ANTHROPIC_BASE_URL": "https://api.vilao.ai",
    "CLAUDE_MODEL": "claude-haiku-4.5",
    // Zalo gửi webhook vào trạm chuyển tiếp Supabase (supabase/functions/
    // zalo-webhook), trạm chuyển sang worker. Lý do: workers.dev chặn
    // User-Agent "Java/1.8..." của Zalo bằng lỗi 1010, không tắt được.
    "ZALO_WEBHOOK_URL": "https://xtutpuwesganunktrxcv.supabase.co/functions/v1/zalo-webhook"
  }
}
